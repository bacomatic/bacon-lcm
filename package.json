{
  "name": "bacon-lcm",
  "version": "0.1.0",
  "description": "Lossless Context Memory — a deterministic, database-backed context management system for LLM agents, modelled after the Voltropy LCM paper.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bacon-lcm-mcp": "dist/mcp-server.js",
    "bacon-lcm-hook": "dist/hooks/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "lcm",
    "lossless-context",
    "llm",
    "memory",
    "context-management",
    "agent"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "pg": "^8.20.0",
    "uuid": "^14.0.0"
  }
}
