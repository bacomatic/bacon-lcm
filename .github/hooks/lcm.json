{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node ./dist/hooks/cli.js --platform copilot --hook sessionStart",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "node ./dist/hooks/cli.js --platform copilot --hook sessionEnd",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node ./dist/hooks/cli.js --platform copilot --hook userPromptSubmitted",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "node ./dist/hooks/cli.js --platform copilot --hook preToolUse",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node ./dist/hooks/cli.js --platform copilot --hook postToolUse",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
